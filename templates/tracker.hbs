{{!-- ApplicationV2 requires every PARTS template to render EXACTLY ONE root
      element, so this wrapper is structural. It is also what the stylesheet's
      container query measures, which is what folds the window into a single
      column on a narrow drag. --}}
<div class="toa-root">

  {{#if noGM}}
  <div class="toa-banner" role="status">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span>{{localize "toa-adventure-tracker.notify.noGM"}}</span>
  </div>
  {{/if}}

  <div class="toa-scroll">

    {{!-- ---------------------------------------------------------------
          DAY + MOON
    ---------------------------------------------------------------- --}}
    <section class="toa-panel toa-head">
      <div class="toa-day">
        <h2 class="toa-panel-title">{{localize "toa-adventure-tracker.app.day"}}</h2>
        <div class="toa-day-row">
          {{#if gm}}
          <button type="button" class="toa-step" data-action="dayDown"
                  data-tooltip="toa-adventure-tracker.app.dayDown"
                  aria-label="{{localize 'toa-adventure-tracker.app.dayDown'}}">
            <i class="fa-solid fa-minus"></i>
          </button>
          <input class="toa-day-input" type="number" min="1" step="1" value="{{day}}" data-day-input
                 aria-label="{{localize 'toa-adventure-tracker.app.daySet'}}">
          <button type="button" class="toa-step" data-action="dayUp"
                  data-tooltip="toa-adventure-tracker.app.dayUp"
                  aria-label="{{localize 'toa-adventure-tracker.app.dayUp'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{else}}
          <span class="toa-day-static">{{day}}</span>
          {{/if}}
        </div>
        {{#if exhaustion}}
        <p class="toa-warn toa-compact">
          <i class="fa-solid fa-bed"></i>
          {{localize "toa-adventure-tracker.app.partyExhausted"}} {{exhaustion}}
        </p>
        {{/if}}
      </div>

      {{!-- Drawn, not an image: the cycle length is a setting, so there is no
            fixed set of pictures to ship (see moon.discPath). --}}
      <figure class="toa-moon" data-tooltip-text="{{moon.tooltip}}">
        <svg class="toa-moon-svg" viewBox="0 0 {{disc.size}} {{disc.size}}"
             width="{{disc.size}}" height="{{disc.size}}" role="img"
             aria-label="{{moon.label}} &ndash; {{moon.percent}}%">
          <circle class="toa-moon-dark" cx="{{disc.centre}}" cy="{{disc.centre}}" r="{{disc.radius}}"/>
          {{#if moon.path}}<path class="toa-moon-lit" d="{{moon.path}}"/>{{/if}}
          <circle class="toa-moon-rim" cx="{{disc.centre}}" cy="{{disc.centre}}" r="{{disc.radius}}"/>
        </svg>
        <figcaption class="toa-moon-caption">
          <strong>{{moon.label}}</strong>
          <span class="toa-moon-meta">{{moon.percent}}%{{#if moon.trend}} &middot; {{moon.trend}}{{/if}}</span>
        </figcaption>
      </figure>
    </section>

    {{!-- ---------------------------------------------------------------
          PACE
    ---------------------------------------------------------------- --}}
    {{#if gm}}
    <section class="toa-panel">
      <h2 class="toa-panel-title">{{localize "toa-adventure-tracker.app.mode"}}</h2>
      <div class="toa-modes">
        {{#each modes}}
        <button type="button" class="toa-mode {{#if active}}on{{/if}}"
                data-mode="{{key}}" {{#unless ../gm}}disabled{{/unless}}
                data-tooltip-text="{{hint}}">
          <i class="{{icon}}"></i>
          <span class="toa-mode-name">{{label}}</span>
          <span class="toa-mode-range">{{range}}</span>
        </button>
        {{/each}}
      </div>
      <p class="toa-hint toa-compact">{{localize "toa-adventure-tracker.app.modeHint"}}</p>
    </section>

    <section class="toa-panel">
      <h2 class="toa-panel-title">{{localize "toa-adventure-tracker.app.pace"}}</h2>
      <div class="toa-paces">
        {{#each paces}}
        <button type="button" class="toa-pace {{#if active}}on{{/if}}"
                data-pace="{{key}}" {{#unless ../gm}}disabled{{/unless}}>
          <span class="toa-pace-name">{{label}}</span>
          <span class="toa-pace-max">
            {{localize "toa-adventure-tracker.app.upTo"}} {{max}}
            {{localize "toa-adventure-tracker.app.hexes"}}
          </span>
          <span class="toa-pace-mod">
            {{#if modLabel}}{{modLabel}} {{localize "toa-adventure-tracker.app.onNavigation"}}{{/if}}
            {{#each roleMods}}
            <span class="{{#if bad}}toa-mod-bad{{else}}toa-mod-good{{/if}}">{{mod}} {{label}}</span>
            {{/each}}
            {{#if encounterMod}}<span>{{encounterMod}}% {{localize "toa-adventure-tracker.app.encounters"}}</span>{{/if}}
          </span>
          {{!-- The asterisk on the ceiling above. Without it the normal card was
                blank and read as a strictly worse slow. --}}
          <span class="toa-pace-note">{{note}}</span>
        </button>
        {{/each}}
      </div>
    </section>
    {{else}}
    {{!-- The viewer's version of the two panels above: what the party can see
          for itself, with nothing to press. --}}
    <section class="toa-panel">
      <h2 class="toa-panel-title">{{localize "toa-adventure-tracker.app.travelling"}}</h2>
      <p class="toa-travel-line" data-tooltip-text="{{travel.modeHint}}">
        <i class="{{travel.modeIcon}}"></i>
        <strong>{{travel.mode}}</strong>
        <span class="toa-dim">&middot;</span>
        {{travel.pace}}
      </p>
      {{#if sky.known}}
      <p class="toa-travel-line">
        <i class="fa-solid {{#if sky.rain}}fa-cloud-showers-heavy{{else}}fa-sun{{/if}}"></i>
        {{sky.label}}
      </p>
      {{/if}}
    </section>
    {{/if}}

    {{#if rolling}}
    {{!-- ---------------------------------------------------------------
          ROLES
    ---------------------------------------------------------------- --}}
    <section class="toa-panel">
      <h2 class="toa-panel-title">
        {{localize "toa-adventure-tracker.app.roles"}}
        {{#if pending}}
        <span class="toa-pending">{{pending}} {{localize "toa-adventure-tracker.app.pending"}}</span>
        {{/if}}
      </h2>

      {{#if party.length}}
      <ul class="toa-party">
        {{#each party}}
        <li class="toa-member {{#unless editable}}toa-readonly{{/unless}}">
          <img class="toa-portrait" src="{{img}}" alt="" loading="lazy">

          <div class="toa-member-main">
            <div class="toa-member-name">
              {{name}}
              {{#if exhaustion}}
              <span class="toa-exh" data-tooltip="toa-adventure-tracker.app.exhaustionLevel">
                <i class="fa-solid fa-bed"></i>{{exhaustion}}
              </span>
              {{/if}}
            </div>

            <select class="toa-role-select" data-role-select data-actor-id="{{id}}"
                    {{#unless editable}}disabled{{/unless}}
                    aria-label="{{localize 'toa-adventure-tracker.app.chooseRole'}}">
              <option value="">{{localize "toa-adventure-tracker.app.noRole"}}</option>
              {{#each options}}
              <option value="{{id}}" {{#if selected}}selected{{/if}} title="{{hint}}">
                {{label}} ({{mod}}){{#if taken}} &middot; {{localize "toa-adventure-tracker.app.alreadyTaken"}}{{/if}}
              </option>
              {{/each}}
            </select>

            {{#if roleId}}
            <div class="toa-member-check">
              {{#if icon}}<i class="{{icon}}"></i>{{/if}}
              {{check}}{{#if mod}} {{mod}}{{/if}}
              {{#if paceMod}}<span class="toa-pacemod">{{paceMod}} {{localize "toa-adventure-tracker.app.paceShort"}}</span>{{/if}}
              {{#if dc}}<span class="toa-dc">{{localize "toa-adventure-tracker.app.dc"}} {{dc}}</span>{{/if}}
            </div>
            {{#if hint}}<div class="toa-member-hint">{{hint}}</div>{{/if}}
            {{/if}}
          </div>

          <div class="toa-member-roll">
            {{#if record}}
            {{!-- The one animated thing in the module: a result appearing is how
                  you notice somebody else's roll landed. --}}
            <div class="toa-result toa-appear
                        {{#if record.undecided}}neutral{{else}}{{#if record.success}}ok{{else}}bad{{/if}}{{/if}}"
                 data-tooltip-text="{{record.formula}}">
              <span class="toa-total">{{record.total}}</span>
              {{#unless record.undecided}}
              <span class="toa-verdict">
                {{#if record.success}}{{localize "toa-adventure-tracker.app.success"}}
                {{else}}{{localize "toa-adventure-tracker.app.failure"}}{{/if}}
              </span>
              {{/unless}}
              {{#if record.yield}}
              <span class="toa-yield">+{{record.yield.total}} {{record.yield.unit}}</span>
              {{/if}}
            </div>
            {{/if}}

            {{#if canRoll}}
            <button type="button" class="toa-btn toa-roll" data-action="roll" data-actor-id="{{id}}">
              <i class="fa-solid fa-dice-d20"></i>
              <span>{{#if record}}{{localize "toa-adventure-tracker.app.reroll"}}
                    {{else}}{{localize "toa-adventure-tracker.app.roll"}}{{/if}}</span>
            </button>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="toa-empty">{{localize "toa-adventure-tracker.app.noParty"}}</p>
      {{/if}}

      {{!-- An empty role is a guaranteed failure, and which ones to leave empty
            is the actual choice this window asks for - so it is said up front,
            not discovered afterwards in the report. --}}
      {{#if unfilled.length}}
      <div class="toa-unfilled">
        <span class="toa-unfilled-label">{{localize "toa-adventure-tracker.app.unfilled"}}:</span>
        {{#each unfilled}}
        <span class="toa-tag {{#if critical}}bad{{/if}}">
          {{#if icon}}<i class="{{icon}}"></i>{{/if}} {{label}}
        </span>
        {{/each}}
      </div>
      {{/if}}

      <div class="toa-day-actions">
        {{#if gm}}
        {{!-- The whole morning in one press: roll every outstanding role, then
              work the day out. The narrower buttons stay for when one row needs
              re-rolling or a day needs resolving again. --}}
        <button type="button" class="toa-btn toa-btn-primary" data-action="runDay">
          <i class="fa-solid fa-dice-d20"></i>
          <span>{{localize "toa-adventure-tracker.app.runDay"}}</span>
        </button>
        {{/if}}
        <button type="button" class="toa-btn" data-action="rollAll">
          <i class="fa-solid fa-dice"></i>
          <span>{{localize "toa-adventure-tracker.app.rollAll"}}</span>
        </button>
        {{#if gm}}
        <button type="button" class="toa-btn" data-action="clearRolls"
                data-tooltip="toa-adventure-tracker.app.clearRollsHint">
          <i class="fa-solid fa-eraser"></i>
          <span>{{localize "toa-adventure-tracker.app.clearRolls"}}</span>
        </button>
        <button type="button" class="toa-btn" data-action="resolveDay">
          <i class="fa-solid fa-scale-balanced"></i>
          <span>{{localize "toa-adventure-tracker.app.resolveDay"}}</span>
        </button>
        {{/if}}
      </div>
    </section>
    {{/if}}

    {{!-- ---------------------------------------------------------------
          THE ROLE BOARD
          Everybody's panel: what there is to do, who has it, what it rolls
          and what each of us brings to it. Folded for the GM, who has the
          working surface above; open for a player, for whom this IS the
          window.
    ---------------------------------------------------------------- --}}
    {{#if board.roles.length}}
    <section class="toa-panel">
      <details class="toa-guide" {{#unless gm}}open{{/unless}}>
        <summary>{{localize "toa-adventure-tracker.app.roleBoard"}}</summary>

        <table class="toa-guide-table toa-board">
          <thead>
            <tr>
              <th>{{localize "toa-adventure-tracker.app.role"}}</th>
              <th>{{localize "toa-adventure-tracker.app.onIt"}}</th>
              <th>{{localize "toa-adventure-tracker.app.check"}}</th>
              {{#if board.mine}}
              <th class="toa-board-you" data-tooltip-text="{{board.you}}">
                {{localize "toa-adventure-tracker.app.you"}}
              </th>
              {{/if}}
              <th>{{localize "toa-adventure-tracker.app.effect"}}</th>
              <th>{{localize "toa-adventure-tracker.app.ifUnfilled"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each board.roles}}
            <tr class="{{#if empty}}toa-board-empty{{/if}}">
              <td class="toa-guide-role" data-tooltip-text="{{hint}}">
                {{#if icon}}<i class="{{icon}}"></i>{{/if}} {{label}}
              </td>

              <td class="toa-board-holders">
                {{#each holders}}
                <span class="toa-holder {{#if rolled}}rolled{{/if}}">
                  <img src="{{img}}" alt="" loading="lazy">
                  <span class="toa-holder-name">{{name}}</span>
                  <span class="toa-holder-mod">{{mod}}</span>
                </span>
                {{else}}
                <span class="toa-dim">{{localize "toa-adventure-tracker.app.nobody"}}</span>
                {{/each}}
              </td>

              <td class="toa-guide-check">
                {{check}}{{#if dc}} <span class="toa-dc">{{localize "toa-adventure-tracker.app.dc"}} {{dc}}</span>{{/if}}
                {{#if paceMod}}
                <span class="toa-pacemod"
                      data-tooltip="toa-adventure-tracker.app.paceModHint">{{paceMod}}</span>
                {{/if}}
              </td>

              {{#if ../board.mine}}
              <td class="toa-board-you"
                  data-label="{{localize 'toa-adventure-tracker.app.you'}}">{{you}}</td>
              {{/if}}

              <td>{{effect}}</td>
              <td class="{{#if critical}}toa-mod-bad{{/if}}">{{unfilled}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>

        <p class="toa-hint toa-compact">{{localize "toa-adventure-tracker.app.boardHint"}}</p>
      </details>
    </section>
    {{/if}}

    {{!-- ---------------------------------------------------------------
          READY FOR TOMORROW
          The one control a player always has, and the list that answers
          "can we move on yet" without asking the table out loud.
    ---------------------------------------------------------------- --}}
    {{#if ready.total}}
    <section class="toa-panel">
      <h2 class="toa-panel-title">
        {{localize "toa-adventure-tracker.app.ready"}}
        <span class="toa-pending {{#if ready.all}}toa-ready-all{{/if}}">{{ready.count}}/{{ready.total}}</span>
      </h2>

      <ul class="toa-readylist">
        {{#each ready.rows}}
        <li class="toa-readyrow {{#if ready}}on{{/if}}">
          <img class="toa-portrait" src="{{img}}" alt="" loading="lazy">
          <span class="toa-readyname">{{name}}</span>
          {{#if editable}}
          <button type="button" class="toa-btn toa-readybtn" data-action="ready"
                  data-actor-id="{{id}}" data-ready="{{#if ready}}false{{else}}true{{/if}}">
            <i class="fa-solid {{#if ready}}fa-rotate-left{{else}}fa-check{{/if}}"></i>
            <span>{{#if ready}}{{localize "toa-adventure-tracker.app.notReadyYet"}}
                  {{else}}{{localize "toa-adventure-tracker.app.imReady"}}{{/if}}</span>
          </button>
          {{else}}
          <span class="toa-readystate">
            {{#if ready}}<i class="fa-solid fa-check"></i> {{localize "toa-adventure-tracker.app.isReady"}}
            {{else}}<i class="fa-regular fa-hourglass"></i> {{localize "toa-adventure-tracker.app.stillBusy"}}{{/if}}
          </span>
          {{/if}}
        </li>
        {{/each}}
      </ul>

      {{#if ready.all}}
      <p class="toa-hint toa-compact">
        <i class="fa-solid fa-check"></i>
        {{localize "toa-adventure-tracker.app.allReady"}}
        {{#if ready.auto}}{{localize "toa-adventure-tracker.app.allReadyAuto"}}{{/if}}
      </p>
      {{else if ready.waiting.length}}
      <p class="toa-hint toa-compact">
        {{localize "toa-adventure-tracker.app.waitingOn"}} {{#each ready.waiting}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}
      </p>
      {{/if}}
    </section>
    {{/if}}

    {{!-- ---------------------------------------------------------------
          THE DAY'S REPORT
          Every number comes with its reason attached.
    ---------------------------------------------------------------- --}}
    {{#if report}}
    <section class="toa-panel toa-report">
      <h2 class="toa-panel-title">
        {{localize "toa-adventure-tracker.app.report"}}
        <span class="toa-weather"><i class="{{report.modeIcon}}"></i> {{report.mode}}</span>
      </h2>

      {{!-- The level the encounter suggestions are budgeted against. Editable
            here as well as in the settings, because it is the one number a GM
            changes mid-campaign. --}}
      {{#if gm}}
      <div class="toa-level">
        <label>
          {{localize "toa-adventure-tracker.app.partyLevel"}}
          <input type="number" min="0" max="20" step="1" value="{{partyLevel}}" data-party-level>
        </label>
        <span class="toa-hint">
          {{localize "toa-adventure-tracker.app.budgetFor"}}
          {{budget.size}} &times; {{localize "toa-adventure-tracker.app.level"}} {{budget.level}}
          &middot; {{localize "toa-adventure-tracker.app.hard"}} {{budget.hard}}
          &middot; {{localize "toa-adventure-tracker.app.deadly"}} {{budget.deadly}} XP
        </span>
      </div>
      {{/if}}

      <div class="toa-hexbox hex-{{report.hexes}}">
        <span class="toa-hexnum">{{report.hexes}}</span>
        <span class="toa-hexlabel">{{report.hexLabel}}</span>
      </div>

      <ul class="toa-reasons">
        {{#each report.reasons}}
        <li class="{{#if bad}}bad{{/if}}{{#if good}}good{{/if}}">
          <span class="toa-delta">{{#if bad}}&minus;{{/if}}{{#if good}}+{{/if}}</span>
          {{text}}
        </li>
        {{/each}}
      </ul>

      {{!-- Second: what the sky did. Between the distance and the events,
            because that is the order it gets read aloud in. --}}
      <p class="toa-weather-line">
        <i class="fa-solid {{#if report.rain}}fa-cloud-showers-heavy{{else}}fa-sun{{/if}}"></i>
        {{report.weather}}
      </p>

      {{!-- Third: everything that happened. --}}
      {{#if report.events.length}}
      <ul class="toa-events">
        {{#each report.events}}
        <li class="toa-event cat-{{category}} {{#if good}}good{{/if}}">
          <div class="toa-event-title">
            {{title}}
            {{#if blocks}}<span class="toa-tag bad">{{localize "toa-adventure-tracker.effect.blocks"}}</span>{{/if}}
          </div>
          <p class="toa-event-text">{{text}}</p>
          {{#if effects.length}}
          <div class="toa-event-effects">
            {{#each effects}}<span class="toa-tag">{{label}}</span>{{/each}}
          </div>
          {{/if}}

          {{!-- The roll that settled a kin event. Shown with its number: "he
                talked them round" is a verdict, "Überzeugen 17/12" is a fact
                the table can argue with. --}}
          {{#with retort}}
          <div class="toa-event-effects">
            <span class="toa-tag {{#if ok}}good{{else}}bad{{/if}}">
              <i class="fa-solid fa-comment"></i>
              {{by}} &middot; {{skill}} {{#if total}}{{total}}/{{dc}}{{/if}}
            </span>
          </div>
          {{/with}}

          {{!-- How many of them make a real fight. A suggestion, nothing more:
                the module never spawns a token or starts combat. --}}
          {{#if foe}}
          <div class="toa-foe">
            <i class="fa-solid fa-swords"></i>
            <span class="toa-foe-name">{{foe.name}}</span>
            <span class="toa-foe-cr">{{localize "toa-adventure-tracker.app.cr"}} {{foe.cr}}</span>
            {{#if foe.overwhelming}}
            <span class="toa-tag bad">{{localize "toa-adventure-tracker.app.overwhelming"}}</span>
            {{else if foe.hardImpossible}}
            {{!-- Even one is past "hard", so there is no hard number to give. --}}
            <span class="toa-tag bad">
              {{localize "toa-adventure-tracker.app.deadly"}}: {{foe.deadly}}&times;
            </span>
            {{else}}
            <span class="toa-tag">{{localize "toa-adventure-tracker.app.hard"}}: {{foe.hard}}&times;</span>
            <span class="toa-tag bad">
              {{localize "toa-adventure-tracker.app.deadly"}}: {{foe.deadly}}&times;{{#if foe.capped}}+{{/if}}
            </span>
            {{/if}}
          </div>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="toa-hint">{{localize "toa-adventure-tracker.app.quietDay"}}</p>
      {{/if}}

      {{!-- The carers. Above the roster because it is the answer to "did the
            medic do anything", which is otherwise read off an absence. --}}
      {{#if report.care.length}}
      <ul class="toa-care">
        {{#each report.care}}
        <li class="{{#if good}}ok{{/if}} {{#if idle}}idle{{/if}}">
          <i class="fa-solid {{#if good}}fa-hand-holding-medical{{else}}fa-minus{{/if}}"></i>
          <strong>{{label}}</strong> &middot; {{text}}
        </li>
        {{/each}}
      </ul>
      {{/if}}

      {{!-- ONE LINE PER TRAVELLER, the untouched ones included: a name simply
            missing from this list reads as forgotten rather than as spared,
            and whether tonight is a rest is the most consequential thing the
            report says to a party that cannot long rest. --}}
      {{#if report.consequences.length}}
      <h3 class="toa-sub-title">{{localize "toa-adventure-tracker.app.consequences"}}</h3>
      <ul class="toa-consequences">
        {{#each report.consequences}}
        <li class="{{#if untouched}}toa-untouched{{/if}}">
          <strong>{{actorName}}</strong>
          {{#if damage}}<span class="toa-tag bad">&minus;{{damage}} {{localize "toa-adventure-tracker.app.hp"}}</span>{{/if}}
          {{#if exhaustion}}<span class="toa-tag bad">+{{exhaustion}} {{localize "toa-adventure-tracker.app.exhaustionShort"}}</span>{{/if}}
          {{#if heals}}<span class="toa-tag good">&minus;{{heals}} {{localize "toa-adventure-tracker.app.exhaustionShort"}}</span>{{/if}}
          {{#if untouched}}<span class="toa-tag">{{localize "toa-adventure-tracker.app.noEffect"}}</span>{{/if}}
          {{!-- Not the same thing: the jungle came at them and missed. The save
                beside this tag is the whole reason the day cost nothing. --}}
          {{#if warded}}
          <span class="toa-tag good" data-tooltip="toa-adventure-tracker.app.wardedHint">
            <i class="fa-solid fa-shield"></i> {{localize "toa-adventure-tracker.app.warded"}}
          </span>
          {{/if}}

          {{!-- The night. A camp event that got through costs the breather -
                which for a table that cannot long rest is the whole day's
                bill. --}}
          {{#if restless}}
          <span class="toa-tag bad" data-tooltip="toa-adventure-tracker.app.noRestHint">
            <i class="fa-solid fa-fire-flame-curved"></i> {{localize "toa-adventure-tracker.app.noRest"}}
          </span>
          {{else}}
          <span class="toa-tag good">
            <i class="fa-solid fa-campground"></i> {{localize "toa-adventure-tracker.app.shortRest"}}
          </span>
          {{/if}}

          {{!-- The saves were rolled without chat cards, so their numbers only
                exist here. --}}
          {{#each saves}}
          <span class="toa-tag {{#if saved}}good{{/if}}">
            {{ability}} {{total}}/{{dc}}
          </span>
          {{/each}}
        </li>
        {{/each}}
      </ul>
      {{#unless report.willApply}}
      <p class="toa-hint">{{localize "toa-adventure-tracker.app.notApplied"}}</p>
      {{/unless}}

      {{!-- Applying is its own decision: the jungle has already bitten, but the
            party may not be bedding down yet. The flag lives on the stored
            report, so this cannot take the same hit points off twice.

            Gated on there being something to WRITE, which is no longer the same
            as the roster having rows in it - everybody is listed now, including
            the people the day did nothing to. A button that applies nothing is
            a button that teaches you to distrust it. --}}
      {{#if report.hasConsequences}}
      {{#if gm}}
      <div class="toa-day-actions">
        {{#if report.applied}}
        <span class="toa-tag good">
          <i class="fa-solid fa-check"></i> {{localize "toa-adventure-tracker.app.applied"}}
        </span>
        {{else}}
        <button type="button" class="toa-btn toa-btn-primary" data-action="applyNow">
          <i class="fa-solid fa-hand-holding-medical"></i>
          <span>{{localize "toa-adventure-tracker.app.applyNow"}}</span>
        </button>
        {{/if}}
      </div>
      {{/if}}
      {{/if}}
      {{/if}}

      {{#if gm}}
      <div class="toa-day-actions">
        <button type="button" class="toa-btn toa-btn-primary" data-action="completeDay">
          <i class="fa-solid fa-flag-checkered"></i>
          <span>{{localize "toa-adventure-tracker.app.completeDay"}}</span>
        </button>
        <button type="button" class="toa-btn" data-action="resolveDay">
          <i class="fa-solid fa-rotate"></i>
          <span>{{localize "toa-adventure-tracker.app.resolveAgain"}}</span>
        </button>
        <button type="button" class="toa-btn" data-action="discardReport">
          <i class="fa-solid fa-xmark"></i>
          <span>{{localize "toa-adventure-tracker.app.discard"}}</span>
        </button>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if reportHidden}}
    <section class="toa-panel">
      <p class="toa-hint toa-compact">
        <i class="fa-solid fa-eye-slash"></i>
        {{localize "toa-adventure-tracker.app.reportHidden"}}
      </p>
    </section>
    {{/if}}

    {{#if log}}
    {{!-- ---------------------------------------------------------------
          LOGBOOK
    ---------------------------------------------------------------- --}}
    <section class="toa-panel">
      <h2 class="toa-panel-title">
        {{localize "toa-adventure-tracker.app.log"}}
        {{#unless log.empty}}
        <span class="toa-total-miles">
          {{localize "toa-adventure-tracker.log.totalShort"}}: {{log.totalHexes}}
          {{localize "toa-adventure-tracker.app.hexes"}}
        </span>
        {{/unless}}
      </h2>

      {{#if log.empty}}
      <p class="toa-empty">{{localize "toa-adventure-tracker.app.noLog"}}</p>
      {{else}}
      <div class="toa-table-wrap">
        <table class="toa-log">
          <thead>
            <tr>
              <th>{{localize "toa-adventure-tracker.log.day"}}</th>
              <th>{{localize "toa-adventure-tracker.log.hexes"}}</th>
              <th>{{localize "toa-adventure-tracker.log.mode"}}</th>
              <th>{{localize "toa-adventure-tracker.log.weather"}}</th>
              <th>{{localize "toa-adventure-tracker.log.damage"}}</th>
              <th>{{localize "toa-adventure-tracker.log.exhaustion"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each log.entries}}
            <tr>
              <td>{{day}}</td>
              <td>{{#if legacy}}&mdash;{{else}}{{hexes}}{{/if}}</td>
              <td>{{#if modeLabel}}{{modeLabel}}{{else}}&mdash;{{/if}}</td>
              <td>{{#if weatherLabel}}{{weatherLabel}}{{else}}&mdash;{{/if}}</td>
              <td>{{#if damage}}{{damage}}{{else}}&mdash;{{/if}}</td>
              <td>{{#if exhaustion}}{{exhaustion}}{{else}}&mdash;{{/if}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}

      {{#if gm}}
      <div class="toa-day-actions">
        <button type="button" class="toa-btn" data-action="exportLog">
          <i class="fa-solid fa-book"></i>
          <span>{{localize "toa-adventure-tracker.app.exportLog"}}</span>
        </button>
        <button type="button" class="toa-btn" data-action="clearLog">
          <i class="fa-solid fa-trash"></i>
          <span>{{localize "toa-adventure-tracker.app.clearLog"}}</span>
        </button>
      </div>
      {{/if}}
    </section>
    {{/if}}

  </div>
</div>
